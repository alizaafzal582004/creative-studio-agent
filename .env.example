# Copy this file to .env and fill in your keys. Never commit .env.

# Required (both have free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: keys from additional Groq ACCOUNTS (limits are per account)
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Optional: pin a Gemini model (default: best available Flash model)
GEMINI_MODEL=

# Optional: stock B-roll sources
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional: password-protect the web app
APP_PASSWORD=

# Optional: deploy to Hugging Face Spaces with `python deploy_hf.py` (a "Write" token)
HF_TOKEN=
