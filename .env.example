# Copy this file to .env and fill in your keys. Never commit .env.

# Required (free tier available)
GROQ_API_KEY=

# Optional: keys from additional Groq ACCOUNTS (limits are per account)
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Optional: Gemini as a second AI provider (without it, everything runs on Groq)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: stock B-roll sources
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional: password-protect the web app
APP_PASSWORD=

# Optional: deploy to Hugging Face Spaces with `python deploy_hf.py` (a "Write" token)
HF_TOKEN=

# Optional: CPU use while rendering. Default = half the cores (cool mode, keeps laptops from overheating).
# CPU_THREADS=0 = all cores (desktops / good cooling). FFMPEG_AT_ONCE = FFmpeg processes at once (default 2).
CPU_THREADS=
FFMPEG_AT_ONCE=
# Optional: thermal guard. At TEMP_PAUSE °C (default 88) rendering pauses until the CPU is back at
# TEMP_RESUME °C (default 75), so an overheating laptop never shuts down. TEMP_PAUSE=0 = off.
TEMP_PAUSE=
TEMP_RESUME=
